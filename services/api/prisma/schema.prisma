generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  passwordHash  String?
  role          UserRole @default(CUSTOMER)
  district      String?
  state         String?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farmer        Farmer?
  customer      Customer?
  shop          Shop?
  trader        Trader?
  admin         Admin?
  orders        Order[]
  payments      Payment[]
  notifications Notification[]
}

model Farmer {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  farmName      String
  farmAddress   String?
  landSize      String?
  kycStatus     KycStatus @default(PENDING)
  rating        Float    @default(0)
  totalOrders   Int      @default(0)
  productsCount Int      @default(0)
  earnings      Float    @default(0)
  bankAccount   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  orders        Order[]
}

model Customer {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  address     String?
  city        String?
  preferred   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shop {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  shopName    String?
  gstNumber   String?
  creditLimit Float   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
}

model Trader {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  companyName String?
  warehouse   String?
  inventory   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
}

model Admin {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id            String   @id @default(cuid())
  farmerId      String
  farmer        Farmer   @relation(fields: [farmerId], references: [id])
  category      ProductCategory
  name          String
  description   String?
  unit          String
  pricePerUnit  Float
  stockQuantity Int
  qualityGrade  String   @default("A")
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems    OrderItem[]
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique @default(cuid())
  farmerId      String?
  farmer        Farmer?  @relation(fields: [farmerId], references: [id])
  buyerId       String
  buyer         User     @relation(fields: [buyerId], references: [id])
  shopId        String?
  shop          Shop?    @relation(fields: [shopId], references: [id])
  traderId      String?
  trader        Trader?  @relation(fields: [traderId], references: [id])
  buyerType     BuyerType
  totalAmount   Float
  paymentMethod String?
  status        OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  deliveryDate  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         OrderItem[]
  payments      Payment[]
  deliveries    Delivery[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  price       Float
  total       Float
  createdAt   DateTime @default(now())
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  provider       String   @default("RAZORPAY")
  amount         Float
  status         PaymentStatus @default(PENDING)
  providerRef    String?
  signature      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Delivery {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  status        DeliveryStatus @default(PENDING)
  assignedAgent String?
  trackingCode  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum UserRole {
  FARMER
  CUSTOMER
  SHOP_OWNER
  TRADER
  ADMIN
}

enum ProductCategory {
  GRAINS
  VEGETABLES
  FRUITS
  SPICES
  OTHER
}

enum BuyerType {
  CUSTOMER
  SHOP
  TRADER
  FARMER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PACKING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}
